# Local development environment variables for Cloudflare Workers
# Copy this file to .dev.vars and fill in your actual values

# Session signing key (REQUIRED in production)
# The session cookie is signed with HMAC-SHA-256 using this value; without it the
# app issues no sessions and verifies none, so nobody can log in. Local dev falls
# back to a built-in insecure secret (compiled out of production builds) if unset.
# Generate with: openssl rand -base64 32
# Set in production with: wrangler pages secret put SESSION_SECRET
SESSION_SECRET=generate_a_random_value_here

# GitHub OAuth Configuration
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_OWNER_ID=your_github_user_id_here

# Discord OAuth Configuration
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Note: .dev.vars is gitignored and should never be committed
# These values are used by `wrangler dev` for local development

# Cloudflare account for the local Workers AI binding.
# `getPlatformProxy()` (used by `vite dev`) authenticates as your wrangler OAuth
# login. If that login can see more than one Cloudflare account, the AI binding
# fails with "More than one account available...". Set this to the account_id
# whose Workers AI quota you want to use.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
